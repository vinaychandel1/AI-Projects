# Example Environment Configuration
# Copy this to .env and fill in your actual values

# ===== REQUIRED =====

# News API Key (Get from https://newsapi.org)
NEWS_API_KEY=your_news_api_key_here

# Your Phone Number (for WhatsApp/SMS)
WHATSAPP_TO_NUMBER=918219895658

# ===== TWILIO (for WhatsApp/SMS) =====

# Get from https://console.twilio.com
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here

# WhatsApp Sandbox Number (usually +14155238886)
TWILIO_FROM_NUMBER=whatsapp:+14155238886

# Or SMS Phone Number (get from Twilio)
TWILIO_PHONE_NUMBER=+15551234567

# ===== EMAIL (Alternative Delivery) =====

# Your Email
EMAIL_TO=your.email@gmail.com

# Gmail Credentials (use App Password, not regular password)
EMAIL_USER=your.email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password_here

# ===== SCHEDULE =====

# Time to send news (7:30 AM IST = 2:00 AM UTC)
SCHEDULE_TIME=7:30 AM
SCHEDULE_CRON=30 2 * * *

# ===== OPTIONAL =====

# Test mode (true = don't send, false = send real messages)
TEST_MODE=false

# AI Summarization (Optional - requires OpenRouter/OpenAI key)
OMNIROUTE_API_KEY=your_omniroute_api_key_here
OMNIROUTE_API_URL=https://openrouter.ai/api/v1/chat/completions

# Meta WhatsApp Cloud API (Alternative to Twilio)
WHATSAPP_API_URL=https://graph.facebook.com/v18.0/YOUR_PHONE_NUMBER_ID/messages
WHATSAPP_ACCESS_TOKEN=your_whatsapp_token_here
