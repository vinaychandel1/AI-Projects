{
  "name": "skillmatch-jobs",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "dev:web": "npm run dev --workspace=web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace=@skillmatch/db",
    "db:migrate": "npm run db:migrate --workspace=@skillmatch/db",
    "db:push": "npm run db:push --workspace=@skillmatch/db",
    "db:studio": "npm run db:studio --workspace=@skillmatch/db",
    "db:seed": "npm run db:seed --workspace=@skillmatch/db"
  },
  "devDependencies": {
    "@prisma/client": "5.18.0",
    "prisma": "5.18.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@prisma/client": "5.18.0",
    "prisma": "5.18.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
